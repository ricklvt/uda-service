APP_NAME=uda-service-dev
LOG_LEVEL=debug

# MQTT broker for the AI Audio listener. TLS (mqtts) + client certs are required
# outside a local broker.
MQTT_HOST=""
MQTT_PORT=8883
MQTT_PROTO=mqtts
MQTT_USER=""
MQTT_PASSWORD=""
MQTTS_CA_PATH=""
MQTTS_KEY_PATH=""
MQTTS_CERT_PATH=""

OPENAI_API_KEY=""

# Optional: point at an OpenAI-compatible endpoint / override the model
# OPENAI_BASE_URL="https://..."
# OPENAI_MODEL="gpt-4o-mini"
